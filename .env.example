# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

# Meta Ad Library API (token de usuario con identidad verificada en facebook.com/ID)
META_ACCESS_TOKEN=
META_API_VERSION=v21.0

# PageSpeed Insights (opcional; sin clave hay límite muy bajo de peticiones)
PAGESPEED_API_KEY=

# Apollo REST (solo si no se usa el conector MCP de Apollo)
APOLLO_API_KEY=

# ID de la hoja de Google Sheets que hace de CRM
CRM_SPREADSHEET_ID=17gWx4WwjSL20IjUQnzvfZsPR9USTCE7xZGTAJa_hBi8
